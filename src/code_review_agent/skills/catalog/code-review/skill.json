{
  "name": "code-review",
  "display_name": "Code Review",
  "description": "Review code changes or repository code for bugs, regressions, risks, and missing tests.",
  "routing": {
    "intents": ["code review", "review diff", "find bugs", "risk analysis"],
    "keywords": ["review", "审查", "代码审查", "PR", "diff", "风险", "bug", "regression"],
    "file_globs": ["*.py", "*.ts", "*.tsx", "*.js", "*.jsx"],
    "priority": 80
  },
  "tools": ["list_files", "read_file", "search_text", "run_command"],
  "default_max_iterations": 100,
  "default_max_tokens": null
}
