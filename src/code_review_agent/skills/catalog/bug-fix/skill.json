{
  "name": "bug-fix",
  "display_name": "Bug Fix",
  "description": "Diagnose failing behavior, errors, stack traces, failing tests, or user-reported bugs.",
  "routing": {
    "intents": ["debug failure", "fix bug", "investigate error", "test failure"],
    "keywords": ["失败", "报错", "bug", "fix", "debug", "traceback", "exception", "pytest", "测试失败"],
    "file_globs": ["*.py", "*.ts", "*.tsx", "*.js", "*.jsx"],
    "priority": 70
  },
  "tools": ["list_files", "read_file", "search_text", "run_command"],
  "default_max_iterations": 100,
  "default_max_tokens": null
}
