{
  "name": "code-review-agent",
  "version": "0.2.0-dev.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "build:web": "pnpm --filter @code-review-agent/web build && pnpm --filter @code-review-agent/web build:browser",
    "build:web:browser": "pnpm --filter @code-review-agent/web build:browser",
    "test:phase7:browser": "pnpm typecheck && pnpm build:web && node scripts/phase7-browser-gate.mjs",
    "test:phase8:worktree": "pnpm typecheck && pnpm build:web && node scripts/phase8-worktree-gate.mjs",
    "typecheck": "tsc -b",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:contracts": "pnpm --filter @code-review-agent/contracts test",
    "test:storage": "pnpm --filter @code-review-agent/storage test",
    "dev:api": "pnpm --filter @code-review-agent/api dev",
    "dev:web": "pnpm --filter @code-review-agent/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
