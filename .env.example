# TypeScript API model configuration. Copy this file to `.env` locally; `.env` is ignored by Git.
# `auto` selects DeepSeek when DEEPSEEK_API_KEY is non-empty, otherwise it uses the local Echo model.
# Supported DeepSeek models: deepseek-v4-flash, deepseek-v4-pro, deepseek-v4-flash-vision-exp.
MODEL_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=3210
# Optional Coding Agent runtime configuration. New CODING_AGENT_* values take
# precedence over the legacy CODE_REVIEW_* migration aliases.
# CODING_AGENT_DB_PATH=
# CODING_AGENT_PWSH=
# CODING_AGENT_PORT=3210
# CODING_AGENT_WORKSPACE_HOST_ROOT=.
