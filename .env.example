# TypeScript API model configuration. Copy this file to `.env` locally; `.env` is ignored by Git.
# `auto` selects DeepSeek when DEEPSEEK_API_KEY is non-empty, otherwise it uses the local Echo model.
MODEL_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Legacy Python prototype/provider settings; the TypeScript API does not read these values.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat
API_KEY=
RUNTIME_WORKSPACE_ROOT=/path/to/allowed/workspaces
DATABASE_URL=sqlite:///./runtime.db
RUN_TIMEOUT_SECONDS=300
MODEL_REQUEST_TIMEOUT_SECONDS=180
MAX_CONCURRENT_RUNS=4
ENABLED_TOOLS=list_files,read_file,search_text,run_command
