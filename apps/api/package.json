{
  "name": "@coding-agent/api",
  "version": "0.2.0-dev.1",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "predev": "pnpm --filter @coding-agent/web build:browser",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
